{
  "author": "André Kreienbring",
  "name": "@s-central/server",
  "license": "AGPL-3.0",
  "version": "3.0.0",
  "description": "Server for S-Central",
  "private": false,
  "scripts": {
    "test": "set NODE_ENV=test&& node --watch shellybroker.js",
    "start": "pm2 flush && pm2 start ecosystem.config.js",
    "dev": "set NODE_ENV=dev&& node --watch shellybroker.js",
    "stop": "pm2 stop shellybroker",
    "list": "pm2 list",
    "logs": "pm2 logs --time",
    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx}\"",
    "lint:fix": "eslint --fix \"src/**/*.{js,jsx,ts,tsx}\""
  },
  "keywords": [],
  "dependencies": {
    "axios": "^1.20.0",
    "better-sqlite3": "^13.0.3",
    "config": "^5.0.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "faye-websocket": "^0.11.4",
    "module-alias": "^2.3.4",
    "pm2": "^7.0.4",
    "prettyjson": "^1.2.5",
    "request-ip": "^3.3.0",
    "rule-engine-js": "^1.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "lodash": "^4.18.1"
  },
  "_moduleAliases": {
    "@root": ".",
    "@http": "./src/http",
    "@devices": "./src/devices",
    "@ws": "./src/ws",
    "@db": "./src/db",
    "@utils": "./src/utils",
    "@public": "./public",
    "@src": "./src"
  },
  "allowScripts": {
    "better-sqlite3@12.10.0": true
  }
}
