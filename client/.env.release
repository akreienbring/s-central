# Used in index.html when buildung a release
# Replace the Placeholders with the IP Adress and Port of your Shellybroker server
# ws- and wss url can have the same values if no certificate is used on the server

VITE_WSURL=ws://[IP]:[PORT]
VITE_WSSURL=wss://[IP]:[PORT]
VITE_RECONNECT_DELAY=2
VITE_RECONNECT_MAX=10
VITE_LANDING_PAGE=login
VITE_VERSION_STRING=Server: 3.0.0, Client: 3.0.0